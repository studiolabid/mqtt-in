{
  "name": "mqtt-in",
  "version": "1.1.0",
  "description": "mqtt-in — a fast, beautiful and powerful MQTT client for the desktop",
  "main": "./out/main/index.js",
  "author": {
    "name": "studiolab.id",
    "url": "https://studiolab.id"
  },
  "homepage": "https://studiolab.id",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && node tests/e2e/check-bundle.mjs && node tests/e2e/run.mjs",
    "test:bundle": "node tests/e2e/check-bundle.mjs",
    "test:package": "node tests/e2e/check-package.mjs",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "mqtt": "^5.16.1",
    "socket.io-client": "^4.8.3",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@electron-toolkit/eslint-config-prettier": "3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@lucide/vue": "^1.70.0",
    "@msgpack/msgpack": "^3.1.3",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/vue-virtual": "^3.13.52",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vueuse/core": "^14.4.0",
    "aedes": "^1.2.0",
    "cborg": "^6.2.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "pinia": "^3.0.4",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "reka-ui": "^2.11.0",
    "socket.io": "^4.8.3",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "uplot": "^1.6.32",
    "vite": "^8.3.4",
    "vitest": "^4.1.12",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^4.6.4",
    "vue-sonner": "^2.0.9",
    "vue-tsc": "^3.3.13",
    "zod": "^4.6.7"
  }
}
